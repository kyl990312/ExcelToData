<Window x:Class="TableEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Editor" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 센터 상단 기능 탭: 탭 헤더 중앙 정렬 -->
        <Style TargetType="TabPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Width" Value="150" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ 하단 상태 바 ═══ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="4,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#2ECC71" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="#F1C40F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="로그 지우기" Command="{Binding ClearLogCommand}" Padding="8,2" Margin="0,0,6,0" />
                    <ToggleButton Content="로그" IsChecked="{Binding IsLogOpen}" Padding="12,2" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ 로그 패널 (상태 바에서 펼침) ═══ -->
        <Border DockPanel.Dock="Bottom" Height="170" BorderThickness="0,1,0,0" BorderBrush="#D5DBE3"
                Visibility="{Binding IsLogOpen, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" TextChanged="LogBox_TextChanged" />
        </Border>

        <!-- ═══ 센터 상단 기능 탭 ═══ -->
        <TabControl Margin="8,8,8,4">

            <!-- ─── 탭 1: 뷰어 ─── -->
            <TabItem Header="뷰어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 상단 툴바 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="새로고침" HorizontalAlignment="Right"
                                Style="{StaticResource ToolButton}" Command="{Binding Viewer.RefreshCommand}" />
                    </DockPanel>

                    <!-- 본문: 좌측 리스트 + 우측 그리드 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 좌측: 검색(상단) + 테이블 리스트 -->
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="검색" Padding="12,3"
                                        Command="{Binding Viewer.SearchCommand}" />
                                <TextBox Margin="0,0,6,0" VerticalContentAlignment="Center"
                                         Text="{Binding Viewer.SearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding Viewer.SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Viewer.Tables}"
                                     SelectedItem="{Binding Viewer.SelectedTable}" />
                        </DockPanel>

                        <!-- 우측: 타입 요약 + 데이터 그리드 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Viewer.TypesSummary}" Foreground="#5B6673"
                                       FontSize="12" Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />

                            <DataGrid Grid.Row="1" AutoGenerateColumns="True"
                                      ItemsSource="{Binding Viewer.TableView}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="All" GridLinesVisibility="All"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" />
                        </Grid>
                    </Grid>

                    <!-- 하단: 행/컬럼 정보 -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Viewer.RowInfo}" VerticalAlignment="Center" Foreground="#5B6673" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ─── 탭 2: 데이터 추출 ─── -->
            <TabItem Header="데이터 추출">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="소스:" VerticalAlignment="Center" />
                            <RadioButton Content="로컬 xlsx" GroupName="ExtractSrc" VerticalAlignment="Center" Margin="8,0,0,0"
                                         IsChecked="{Binding Extract.IsLocalSource}" />
                            <RadioButton Content="GSheet 폴더" GroupName="ExtractSrc" VerticalAlignment="Center" Margin="10,0,0,0"
                                         IsChecked="{Binding Extract.IsGSheetSource}" />
                            <CheckBox Content="Diff만 보기" VerticalAlignment="Center" Margin="20,0,0,0"
                                      IsChecked="{Binding Extract.DiffOnly}"
                                      IsEnabled="{Binding Extract.IsLocalSource}"
                                      ToolTip="git 으로 변경이 감지된 워크북의 테이블만 표시합니다. 저장소 경로는 설정 탭의 Git 항목을 따릅니다." />
                        </StackPanel>
                        <Button Content="목록 새로고침" HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                                Command="{Binding Extract.RefreshCommand}" />
                    </DockPanel>

                    <CheckBox Grid.Row="1" Content="모두 선택/해제" Margin="2,0,0,6"
                              IsChecked="{Binding Extract.CheckAll}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding Extract.Items}" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Content="전체 추출" Style="{StaticResource RunButton}" Command="{Binding Extract.ExtractAllCommand}" />
                            <Button Content="선택 추출" Style="{StaticResource RunButton}" Command="{Binding Extract.ExtractSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── 탭 3: 코드 추출 ─── -->
            <TabItem Header="코드 추출">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="출력 언어:" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CodeGen.LanguageText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Text="(설정 탭에서 변경)" Foreground="#5B6673" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <CheckBox Content="Enum 코드 함께 생성" VerticalAlignment="Center" Margin="24,0,0,0"
                                      IsChecked="{Binding CodeGen.WithEnum}" />
                        </StackPanel>
                        <Button Content="목록 새로고침" HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                                Command="{Binding CodeGen.RefreshCommand}" />
                    </DockPanel>

                    <CheckBox Grid.Row="1" Content="모두 선택/해제" Margin="2,0,0,6"
                              IsChecked="{Binding CodeGen.CheckAll}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding CodeGen.Items}" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Content="전체 생성" Style="{StaticResource RunButton}" Command="{Binding CodeGen.GenerateAllCommand}" />
                            <Button Content="선택 생성" Style="{StaticResource RunButton}" Command="{Binding CodeGen.GenerateSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── 탭 4: 설정 ─── -->
            <TabItem Header="설정">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="기본값 생성" Style="{StaticResource ToolButton}" Command="{Binding Settings.DefaultsCommand}" />
                        <Button Content="검증" Style="{StaticResource ToolButton}" Command="{Binding Settings.ValidateCommand}" />
                        <Button Content="저장" Style="{StaticResource ToolButton}" Command="{Binding Settings.SaveCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                            <Expander Header="데이터 추출 (ExcelToData)" IsExpanded="True" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <!-- 소스 토글: 한 줄 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <CheckBox Content="로컬 xlsx 사용" IsChecked="{Binding Settings.Binary.IsLoadFromLocal}" VerticalAlignment="Center" />
                                        <CheckBox Content="GSheet 사용" IsChecked="{Binding Settings.Binary.IsLoadFromGSheet}" VerticalAlignment="Center" Margin="20,0,0,0" />
                                    </StackPanel>
                                    <!-- Src 경로 -->
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Src 폴더 (원본 xlsx)" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="bin.src" />
                                        <TextBox Text="{Binding Settings.Binary.SrcDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Src GDrive 폴더 링크" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Binary.SrcGDriveLink, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <!-- Dst 경로 -->
                                    <DockPanel Margin="0,8,0,3">
                                        <TextBlock Text="Dst 폴더 (.bin 출력)" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="bin.dst" />
                                        <TextBox Text="{Binding Settings.Binary.DstDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="JSON 추출" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Src 폴더 (.bin)" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="json.src" />
                                        <TextBox Text="{Binding Settings.Json.SrcDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Dst 폴더 (.json 출력)" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="json.dst" />
                                        <TextBox Text="{Binding Settings.Json.DstDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="코드 생성 (CodeGenerator)" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Binary 폴더" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="cg.bin" />
                                        <TextBox Text="{Binding Settings.CodeGen.BinaryDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="테이블 코드 폴더" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="cg.class" />
                                        <TextBox Text="{Binding Settings.CodeGen.ClassOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="DataManager 폴더" Style="{StaticResource FieldLabel}"
                                                   ToolTip="Base/DataManagerAutoGenerated.cs 를 이 폴더 아래에 씁니다. 비우면 테이블 코드 폴더를 씁니다." />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="cg.manager" />
                                        <TextBox Text="{Binding Settings.CodeGen.ManagerOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Info 네임스페이스" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.CodeGen.ClassNamespace, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="코드 확장자 (.cs/.cpp)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.CodeGen.CodeExtension, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Enum (EnumGenerator: enum 소스 → EnumDB)" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Enum 소스 파일 (.cs, 한 줄에 하나)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                        <TextBox Text="{Binding Settings.SystemEnumFilesText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="GAuth (Google 인증)" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="애플리케이션 이름" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.GAuthCfg.ApplicationName, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="사용자 (이메일)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.GAuthCfg.User, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="client_secret 경로" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.GAuthCfg.ClientSceret, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                        <Button Content="Google 인증" Padding="12,4"
                                                Command="{Binding Settings.AuthorizeGoogleCommand}"
                                                ToolTip="GAuth 설정을 저장하고 Google 로그인을 진행합니다. 토큰이 있으면 브라우저 없이 연결만 확인합니다." />
                                        <TextBlock Text="{Binding Settings.GoogleAuthStatus}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Git (버전 관리)" Margin="0,0,0,6">
                                <StackPanel Margin="20,6,0,4">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="저장소 경로" Style="{StaticResource FieldLabel}" />
                                        <Button DockPanel.Dock="Right" Content="찾기" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding Settings.BrowseCommand}" CommandParameter="git.repo" />
                                        <TextBox Text="{Binding Settings.Git.RepositoryPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,0,0,4" Foreground="Gray" TextWrapping="Wrap"
                                               Text="비워 두면 데이터 추출 Src 폴더를 사용합니다. CLI 의 --path 인자가 항상 우선합니다." />
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="git 실행 파일" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Git.GitExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,0,0,2" Foreground="Gray" TextWrapping="Wrap"
                                               Text="기본값 &quot;git&quot; 은 PATH 에서 찾습니다. 전체 경로를 직접 지정해도 됩니다." />
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
