<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\BinaryParser\BinaryParser.csproj" />
    <ProjectReference Include="..\ExcelParser\ExcelParser.csproj" />
    <ProjectReference Include="..\GAuth\GAuth.csproj" />
    <ProjectReference Include="..\ExcelToData\ExcelToData.csproj" />
    <ProjectReference Include="..\CodeGenerator\CodeGenerator.csproj" />
    <ProjectReference Include="..\EnumGenerator\EnumGenerator.csproj" />
    <ProjectReference Include="..\TableAutomarionToolShared\TableAutomarionToolShared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CLI 도구들과 같은 폴더로 출력해 Config/Binary 경로를 공유한다 -->
    <OutputPath>..\Output\$(Configuration)\net9.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
